function barras(titulo, mapa, campo, desfase){
  var claves = Object.keys(mapa || {}).sort(function(a, b){ return mapa[b] - mapa[a]; });
  var max = 0; claves.forEach(function(k){ if (mapa[k] > max) max = mapa[k]; });
  var h = '<div><h4 style="margin-top:0">'+titulo+'</h4>';
  if (!claves.length) return h + '<div class="hint">—</div></div>';
  claves.forEach(function(k, i){
    var nombre = campo==='resultado' ? res(k) : (campo ? et(campo, k) : k);
    if (k==='sin_dato') nombre = 'Sin dato';
    var color = colorBarra(campo, k, i + (desfase || 0));   // v1.0.1: cada bloque empieza por un color distinto
    h += '<div class="barra"><div>'+esc(nombre)+'<div class="b"><i style="width:'+Math.round(100*mapa[k]/max)+'%;background:'+color+'"></i></div></div><div class="v">'+mapa[k]+'</div></div>';
  });
  return h + '</div>';
}
