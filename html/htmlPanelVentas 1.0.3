  $('btnLectura').disabled = true;
  renderLectura();
  send('lectura', { desde:N.desde, hasta:N.hasta, comercialId:N.ver });
});

/* ── Alto del iframe (el del Gestor de equipo) ───────────────────────── */
var lastH = 0;
function notifyHeight(){
  var h = document.documentElement.scrollHeight;
  if (h!==lastH){ lastH = h; send('resize', {height:h}); }
}
try {
  var ro = new ResizeObserver(notifyHeight); ro.observe(document.body);
} catch (e) {
  window.addEventListener('resize', notifyHeight);
  setInterval(notifyHeight, 1200);
}

send('ready', {});
</script>
</body>
</html>
