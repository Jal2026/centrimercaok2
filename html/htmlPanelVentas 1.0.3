    barras('Productos más nombrados', productos, '', 0);
  renderLectura();
  notifyHeight();
}
/* Markdown mínimo de la lectura: ## títulos, listas con «- », **negrita**. */
function md(texto){
  var lineas = String(texto||'').split('\n'); var h = ''; var enLista = false;
  function inl(s){ return esc(s).replace(/\*\*([^*]+)\*\*/g, '<b>$1</b>'); }
  lineas.forEach(function(l){
    var t = l.trim();
    if (/^#{1,6}\s/.test(t)){ if (enLista){ h += '</ul>'; enLista = false; } h += '<h2>'+inl(t.replace(/^#{1,6}\s*/, ''))+'</h2>'; return; }
    if (/^[-*]\s/.test(t)){ if (!enLista){ h += '<ul>'; enLista = true; } h += '<li>'+inl(t.replace(/^[-*]\s*/, ''))+'</li>'; return; }
    if (enLista){ h += '</ul>'; enLista = false; }
    if (t) h += '<p>'+inl(t)+'</p>';
  });
  if (enLista) h += '</ul>';
  return h;
}
function renderLectura(){
  var l = N.lecturas[claveLectura()];
  $('btnCopiar').style.display = (l && !l.pidiendo) ? '' : 'none';   // v1.0.3
  if (!l){ $('lectura').innerHTML = ''; $('btnLectura').textContent = 'Preparar lectura'; return; }
  if (l.pidiendo){ $('lectura').innerHTML = '<div class="cargando">Preparando la lectura…</div>'; return; }
  $('btnLectura').textContent = 'Volver a preparar';
  $('lectura').innerHTML = '<div class="lectura" style="margin-top:12px">'+md(l.texto)+'</div>' +
    '<div class="nota-ia">Preparada por IA con '+(l.visitas===1 ? '1 visita' : l.visitas+' visitas')+' del '+fechaLarga(l.desde)+' al '+fechaLarga(l.hasta)+'. Revisa los datos antes de decidir.</div>';
  notifyHeight();
}

/* v1.0.3 — Copiar la lectura. */
function notaLectura(l){
  return 'Preparada por IA con '+(l.visitas===1 ? '1 visita' : l.visitas+' visitas')+' del '+fechaLarga(l.desde)+' al '+fechaLarga(l.hasta)+'. Revisa los datos antes de decidir.';
}
/* Texto limpio: títulos en mayúsculas, viñetas «•», sin asteriscos. */
function textoPlano(texto){
  return String(texto||'').split('\n').map(function(l){
    var t = l.trim().replace(/\*\*([^*]+)\*\*/g, '$1');
    if (/^#{1,6}\s/.test(t)) return '\n' + t.replace(/^#{1,6}\s*/, '').toUpperCase();
    if (/^[-*]\s/.test(t)) return '• ' + t.replace(/^[-*]\s*/, '');
    return t;
  }).join('\n').replace(/\n{3,}/g, '\n\n').trim();
}
function copiarLectura(){
  var l = N.lecturas[claveLectura()];
  if (!l || l.pidiendo) return;
  var titulo = $('lTitulo').textContent;
  var periodo = 'Del ' + fechaLarga(l.desde) + ' al ' + fechaLarga(l.hasta);
  var plano = titulo + '\n' + periodo + '\n\n' + textoPlano(l.texto) + '\n\n' + notaLectura(l);
  var html = '<div style="font-family:Arial,sans-serif;font-size:14px;line-height:1.5">' +
    '<h1 style="font-size:18px;margin:0 0 4px">'+esc(titulo)+'</h1>' +
    '<p style="margin:0 0 12px;color:#6b7a78">'+esc(periodo)+'</p>' + md(l.texto) +
    '<p style="margin-top:12px;font-size:12px;color:#6b7a78">'+esc(notaLectura(l))+'</p></div>';

  function hecho(){ toast('Lectura copiada.'); }
  function clasico(){
    // Copia clásica: funciona en marcos sin permiso de portapapeles.
    var ta = document.createElement('textarea');
    ta.value = plano; ta.setAttribute('readonly', '');
    ta.style.position = 'fixed'; ta.style.top = '-1000px'; ta.style.opacity = '0';
    document.body.appendChild(ta); ta.select();
    var ok = false;
    try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
    document.body.removeChild(ta);
    if (ok) hecho(); else toast('No se ha podido copiar. Selecciona el texto y cópialo a mano.', 5000);
  }
  try {
    if (navigator.clipboard && window.ClipboardItem && navigator.clipboard.write){
      var item = new ClipboardItem({
        'text/html':  new Blob([html],  { type:'text/html' }),
        'text/plain': new Blob([plano], { type:'text/plain' })
      });
      navigator.clipboard.write([item]).then(hecho, function(){
        navigator.clipboard.writeText(plano).then(hecho, clasico);
      });
      return;
    }
    if (navigator.clipboard && navigator.clipboard.writeText){
      navigator.clipboard.writeText(plano).then(hecho, clasico);
      return;
    }
  } catch (e) { /* se cae a la copia clásica */ }
  clasico();
}

/* ═════════════════════════════════════════════════════════════════════════
 * MENSAJES  (Page → Widget)
 * ═════════════════════════════════════════════════════════════════════════ */
function errorDe(p){ return (p && p.error) || 'desconocido'; }
function esAcceso(p){ return p && p.error && /acceso|sesión/i.test(p.error); }

window.addEventListener('message', function(event){
  var msg = event.data;
  if (!msg || typeof msg!=='object') return;
  var p = msg.payload;

  if (msg.type==='cargado'){
    if (!p || !p.ok){
      if (esAcceso(p)) return bloquear(p.error);
      $('sbEstado').textContent = 'Error de carga';
      toast('Error: ' + errorDe(p), 5000);
      return;
    }
    var primera = !HOY;
    HOY = p.hoy;
    U.usuarios = p.usuarios || [];
    $('sbEstado').textContent = 'Datos de hoy, ' + fechaLarga(HOY);
    if (primera){
      $('aDesde').value = sumarDias(HOY, -6); $('aHasta').value = HOY; $('aDesde').max = HOY; $('aHasta').max = HOY;
      $('nDesde').value = sumarDias(HOY, -29); $('nHasta').value = HOY; $('nDesde').max = HOY; $('nHasta').max = HOY;
      $('mHasta').min = HOY;
    }
    renderUsuarios();
    if (M.para==='elegir') renderPara();
    var activa = document.querySelector('.tab.on').getAttribute('data-tab');
    if (primera && activa!=='usuarios'){ cargadas[activa] = false; irA(activa); }
    return;
  }

  if (msg.type==='equipo'){
    if (!p || !p.ok){ toast('Error: ' + errorDe(p), 5000); return; }
    U.equipo = p.equipo || [];
    renderAlta();
    return;
  }

  if (msg.type==='appActivada'){
    if (!p || !p.ok){
      U.ocupado = {};
      renderUsuarios(); renderAlta();
      toast('Error: ' + errorDe(p), 5000);
      return;
    }
    delete U.ocupado[p.id];
    if (U.equipo){
      U.equipo.forEach(function(x){ if (x.id===p.id) x.appVentas = p.appVentas; });
      renderAlta();
    }
    toast(p.appVentas ? 'App activada.' : 'App desactivada.');
    send('ready', {});   // recarga usuarios con su última visita
    return;
  }

  if (msg.type==='visitas'){
    if (!p || !p.ok){ $('listaVisitas').innerHTML = '<div class="res-empty">'+esc(errorDe(p))+'</div>'; return; }
    A.visitas = p.visitas || [];
    renderVisitas();
    return;
  }

  if (msg.type==='visita'){
    if (!p || !p.ok){ toast('Error: ' + errorDe(p), 5000); return; }
    renderDetalle(p.visita);
    return;
  }

  if (msg.type==='proximas'){ renderProximas(p); return; }

  if (msg.type==='avisos'){
    if (!p || !p.ok){ $('listaAvisos').innerHTML = '<div class="res-empty">'+esc(errorDe(p))+'</div>'; return; }
    M.avisos = p.avisos || [];
    renderAvisos();
    return;
  }

  if (msg.type==='avisoGuardado'){
    $('mGuardar').disabled = false;
    if (!p || !p.ok){ toast('Error: ' + errorDe(p), 5000); return; }
    toast('Aviso guardado.');
    limpiarAviso();
    send('avisos', {});
    return;
  }

  if (msg.type==='barometro'){
    if (!p || !p.ok){ $('kpis').innerHTML = '<div class="res-empty">'+esc(errorDe(p))+'</div>'; return; }
    N.b = p;
    var sigue = !N.ver || p.porComercial.some(function(c){ return c.comercialId===N.ver; });
    if (!sigue) N.ver = '';
    renderBarometro();
    return;
  }

  if (msg.type==='lectura'){
    $('btnLectura').disabled = false;
    var pend = null;
    Object.keys(N.lecturas).forEach(function(k){ if (N.lecturas[k].pidiendo) pend = k; });
    if (!p || !p.ok){
      if (pend) delete N.lecturas[pend];
      renderLectura();
      toast('Error: ' + errorDe(p), 5000);
      return;
    }
    var l = p.lectura;
    N.lecturas[l.desde + '_' + l.hasta + '_' + (l.comercialId || 'equipo')] = l;
    renderLectura();
    return;
  }

  if (msg.type==='error'){
    // Excepción en el puente (p. ej. la lectura superó el tiempo de conexión).
    if (p && p.origen==='lectura'){
      $('btnLectura').disabled = false;
      Object.keys(N.lecturas).forEach(function(k){ if (N.lecturas[k].pidiendo) delete N.lecturas[k]; });
      renderLectura();
      toast('La lectura ha tardado demasiado. Vuelve a pedirla.', 6000);
      return;
    }
    if (p && p.origen==='guardarAviso') $('mGuardar').disabled = false;
    if (p && p.origen==='activarApp'){ U.ocupado = {}; renderUsuarios(); renderAlta(); }
    toast('Error: ' + errorDe(p), 5000);
    return;
  }
});

