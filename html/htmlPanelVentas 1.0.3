    th('Pedidos', 'var(--c-ped)') + th('Sin informe', '') + '</tr></thead><tbody>';
  t += '<tr class="click'+(N.ver===''?' sel':'')+'" data-ver=""><td><b>Todo el equipo</b></td>'+cifras(e)+'</tr>';
  N.b.porComercial.forEach(function(c){
    t += '<tr class="click'+(N.ver===c.comercialId?' sel':'')+'" data-ver="'+esc(c.comercialId)+'"><td>'+esc(c.comercial)+'</td>'+cifras(c)+'</tr>';
  });
